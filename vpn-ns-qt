SCRIPT = Path(os.environ.get("VPN_NS", HERE / "vpn-ns"))
FLAGS = next((d for d in (HERE / "flags", HERE / "rust" / "flags", HERE / "vpn-ns-picker" / "flags") if d.is_dir()), HERE / "flags")
