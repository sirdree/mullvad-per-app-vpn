    # ---------------------------------------------------------------- helpers
    def run(self, args, done, stdin=None):
        p = QProcess(self)
        p.setProgram(str(SCRIPT))
        p.setArguments(args)
        self.procs.add(p)

        def fin(code, _status):
            out = bytes(p.readAllStandardOutput()).decode(errors="replace").strip()
            err = bytes(p.readAllStandardError()).decode(errors="replace").strip()
            self.procs.discard(p)
            p.deleteLater()
            done(code == 0, out, err.splitlines()[0] if err else "failed")

        p.finished.connect(fin)
        if stdin is not None:
            p.started.connect(lambda: (p.write(stdin.encode()), p.closeWriteChannel()))
        p.start()

    def set_msg(self, text, error=False):
        self.msg.setText(text)
        self.msg.setStyleSheet(f"color: {RED.name()};" if error else "")

    def apply_zoom(self):
        f = QApplication.font()
        f.setPointSizeF(self.base_font_pt * self.zoom)
        QApplication.setFont(f)
        self.tree.setIconSize(QSize(round(24 * self.zoom), round(16 * self.zoom)))
        self.tree.header().resizeSection(4, round(100 * self.zoom))

    def set_zoom(self, z):
        self.zoom = max(0.6, min(2.2, z))
        self.apply_zoom()

    def closeEvent(self, e):
        self.settings.setValue("geometry", self.saveGeometry())
        self.settings.setValue("zoom", self.zoom)
        for p in list(self.procs):   # let a running poll/switch finish before the window goes away
            p.waitForFinished(5000)
        super().closeEvent(e)

    # ---------------------------------------------------------------- data
    def rebuild(self):
        self.tree.clear()
        self.countries = []
        self.by_host = {}
        try:
            data = json.load(open(SERVERS))
        except (OSError, ValueError) as e:
            self.set_msg(f"Server list: {e}", error=True)
            return
        relays = sorted((r for r in data if r.get("active") and r.get("type", "wireguard") == "wireguard"),
                        key=lambda r: (r["country_name"], r["city_name"], r["hostname"]))
        speeds = sorted({r["network_port_speed"] for r in relays})
        keep = self.speed.currentData() or 0
        self.speed.blockSignals(True)
        self.speed.clear()
        self.speed.addItem("any speed", 0)
        for sp in speeds:
            self.speed.addItem(f"at least {sp} Gbps", sp)
        self.speed.setCurrentIndex(max(self.speed.findData(keep), 0))
        self.speed.blockSignals(False)
        big = QFont(self.font())
        big.setBold(True)
        big.setPointSizeF(self.font().pointSizeF() + 1.5)
        co = ci = None
        for r in relays:
            if co is None or co["code"] != r["country_code"]:
                item = QTreeWidgetItem(self.tree)
                item.setText(0, r["country_name"])
                item.setFont(0, big)
                flag = FLAGS / f"{r['country_code']}.png"
                if flag.exists():
                    item.setIcon(0, QIcon(QPixmap(str(flag))))
                item.setData(0, ROLE_KIND, "country")
                item.setData(0, ROLE_TARGET, r["country_code"])
                item.setData(0, ROLE_LABEL, f"{r['country_name']} (random)")
                self.add_random(item)
                co = {"code": r["country_code"], "item": item, "cities": []}
                self.countries.append(co)
                ci = None
            if ci is None or ci["code"] != r["city_code"]:
                item = QTreeWidgetItem(co["item"])
                item.setText(0, r["city_name"])
                key = f"{r['country_code']}-{r['city_code']}"
                item.setData(0, ROLE_KIND, "city")
                item.setData(0, ROLE_TARGET, key)
                item.setData(0, ROLE_LABEL, f"{r['city_name']}, {r['country_name']} (random)")
                self.add_random(item)
                ci = {"code": r["city_code"], "key": key, "item": item, "servers": []}
                co["cities"].append(ci)
            item = QTreeWidgetItem(ci["item"])
            item.setText(0, r["hostname"])
            item.setFont(0, self.mono)
            item.setText(2, owner_text(r))
            item.setForeground(2, GREEN if r["owned"] else AMBER)
            item.setText(3, f"{r['network_port_speed']} Gbps")
            item.setTextAlignment(3, Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
            item.setData(0, ROLE_KIND, "server")
            item.setData(0, ROLE_TARGET, r["hostname"])
            item.setData(0, ROLE_LABEL, f"{r['city_name']}, {r['country_name']} ({r['hostname']})")
            hay = " ".join(str(x) for x in (r["country_name"], r["country_code"], r["city_name"], r["hostname"], r["provider"],
                                            "owned mullvad" if r["owned"] else "rented", r["network_port_speed"], "gbps")).lower()
            ci["servers"].append({"item": item, "r": r, "hay": hay})
            self.by_host[r["hostname"]] = {"r": r, "co": co, "ci": ci, "item": item}
        self.was_searching = False
        self.refresh_view()
        self.expand_current_only()
        self.update_count()

    def add_random(self, item):
        b = QPushButton("random")
        b.setToolTip("Connect to a random server here")
        b.setStyleSheet("QPushButton { padding: 1px 12px; border: 1px solid palette(mid); border-radius: 9px; background: palette(button); } "
                        "QPushButton:hover { background: palette(midlight); }")
        b.clicked.connect(lambda _=False, i=item: self.switch(i.data(0, ROLE_TARGET), i.data(0, ROLE_LABEL)))
        self.tree.setItemWidget(item, 4, b)

    # ---------------------------------------------------------------- view
    def refresh_view(self, *_):
        tokens = self.search.text().lower().split()
        owned_only = self.owned.isChecked()
        min_speed = self.speed.currentData() or 0
        searching = bool(tokens)
        cur = self.by_host.get(self.current)
        hits, only = 0, None
        for co in self.countries:
            n_city = n_srv = 0
            for ci in co["cities"]:
                shown = owned_n = top = 0
                for sv in ci["servers"]:
                    r = sv["r"]
                    ok = (not owned_only or r["owned"]) and r["network_port_speed"] >= min_speed and all(t in sv["hay"] for t in tokens)
                    sv["item"].setHidden(not ok)
                    self.style_server(sv["item"], r["hostname"] == self.current)
                    if ok:
                        shown += 1
                        owned_n += 1 if r["owned"] else 0
                        top = max(top, r["network_port_speed"])
                        only = r["hostname"]
                here = cur is not None and cur["ci"] is ci
                ci["item"].setHidden(shown == 0)
                self.set_details(ci["item"], f"{shown} {'server' if shown == 1 else 'servers'} · {owned_n} Mullvad-owned · up to {top} Gbps", here)
                if shown:
                    n_city += 1
                    n_srv += shown
                    if searching:
                        ci["item"].setExpanded(True)
            here = cur is not None and cur["co"] is co
            co["item"].setHidden(n_srv == 0)
            self.set_details(co["item"], f"{n_city} {'city' if n_city == 1 else 'cities'} · {n_srv} {'server' if n_srv == 1 else 'servers'}", here)
            if searching and n_srv:
                co["item"].setExpanded(True)
            hits += n_srv
        self.hits, self.only_hit = hits, (only if hits == 1 else None)
        if self.was_searching and not searching:
            self.expand_current_only()
        self.was_searching = searching
        self.update_count()

    def set_details(self, item, text, here):
        item.setText(1, text + ("   ● connected here" if here else ""))
        item.setForeground(1, GREEN if here else self.palette().placeholderText())

    def style_server(self, item, is_cur):
        host = item.data(0, ROLE_TARGET)
        item.setText(0, ("● " if is_cur else "") + host)
        f = item.font(0)
        f.setBold(is_cur)
        item.setFont(0, f)
        item.setForeground(0, GREEN if is_cur else self.palette().text())
        for c in range(4):
            item.setBackground(c, TINT if is_cur else NO_BRUSH)

    def expand_current_only(self):
        self.tree.collapseAll()
        cur = self.by_host.get(self.current)
        if cur:
            cur["co"]["item"].setExpanded(True)
            cur["ci"]["item"].setExpanded(True)

    def update_count(self):
        self.count.setText(f"{self.hits} {'server' if self.hits == 1 else 'servers'}  ·  {age_text(SERVERS)}")

    def update_top(self):
        self.btn_down.setEnabled(bool(self.current) and not self.busy)
        cur = self.by_host.get(self.current)
        if not cur:
            self.top_flag.clear()
            self.top_text.setText(f'<b style="color:{AMBER.name()}">● Not connected</b> &nbsp;<span style="color:gray">click a server to connect</span>')
            return
        r = cur["r"]
        flag = FLAGS / f"{r['country_code']}.png"
        if flag.exists():
            self.top_flag.setPixmap(QPixmap(str(flag)).scaledToHeight(round(18 * self.zoom), Qt.TransformationMode.SmoothTransformation))
        oc = (GREEN if r["owned"] else AMBER).name()
        self.top_text.setText(
            f'<b style="color:{GREEN.name()}">● Connected</b> &nbsp;{r["city_name"]}, {r["country_name"]} &nbsp;·&nbsp; {r["hostname"]} &nbsp;·&nbsp; '
            f'<span style="color:{oc}">{owner_text(r)}</span> &nbsp;·&nbsp; {r["network_port_speed"]} Gbps')

    # ---------------------------------------------------------------- actions
    def item_clicked(self, item, _col):
        kind = item.data(0, ROLE_KIND)
        if kind == "server":
            self.switch(item.data(0, ROLE_TARGET), item.data(0, ROLE_LABEL))
        else:
            item.setExpanded(not item.isExpanded())

    def enter_pressed(self):
        if self.only_hit:
            item = self.by_host[self.only_hit]["item"]
            self.switch(item.data(0, ROLE_TARGET), item.data(0, ROLE_LABEL))

    def disconnect(self, force):
        if self.busy:
            return
        self.busy = True
        self.btn_down.setEnabled(False)
        self.set_msg("Disconnecting…")

        def done(ok, _out, err):
            self.busy = False
            if ok:
                self.current = ""
                self.refresh_view()
                self.set_msg("Disconnected. Restart any VPN app (e.g. Firefox) to use the VPN again.")
            elif "still running" in err:
                self.set_msg("")
                ask = QMessageBox.question(
                    self, "Disconnect the VPN?",
                    "Apps are still open inside the VPN (for example the VPN Firefox).\n"
                    "They will lose their connection for good and must be restarted.\n\nDisconnect anyway?")
                if ask == QMessageBox.StandardButton.Yes:
                    self.disconnect(True)
                    return
            else:
                self.set_msg(f"Disconnect failed: {err}", error=True)
            self.poll()

        self.run(["down", "force"] if force else ["down"], done)

    def switch(self, target, label):
        if self.busy:
            return
        if not self.key_ok:
            self.set_msg("A valid Mullvad key is needed first.", error=True)
            self.open_key()
            return
        self.busy = True
        self.set_msg(f"Switching to {label}…")

        def done(ok, _out, err):
            self.busy = False
            if ok:
                self.set_msg(f"Switched to {label}")
            else:
                self.set_msg(f"Switch failed: {err}", error=True)
                if "no valid Mullvad key" in err:
                    self.open_key()
            self.poll()

        self.run(["switch", target], done)

    def poll(self):
        def done(ok, out, _err):
            host = out if ok else ""
            if host != self.current:
                first = self.current == "" and host in self.by_host
                self.current = host
                self.refresh_view()
                if first:
                    self.expand_current_only()
            self.update_top()

        self.run(["current"], done)

    def after_startup_refresh(self, ok, _out, err):
        if ok:
            self.rebuild()
            self.update_top()
            self.set_msg("")
        else:
            self.set_msg(f"Could not refresh the list (using the saved one): {err}", error=True)

    def check_key(self):
        self.run(["key", "status"], lambda ok, out, err: self.apply_key_status(out if ok else f"invalid||{err}"))

    def apply_key_status(self, line):
        kind, _, rest = line.partition("|")
        path, _, extra = rest.partition("|")
        self.key_ok = kind == "ok"
        self.key_path = path
        self.key_addr = extra if self.key_ok else ""
        if self.key_ok:
            self.key_problem = ""
        elif kind == "missing":
            self.key_problem = "No Mullvad key is stored yet. Add one to connect."
        else:
            self.key_problem = f"The stored key is not valid: {extra}"
        self.btn_key.setText("Key…" if self.key_ok else "Key needed")
        self.btn_key.setStyleSheet("" if self.key_ok else f"color: {RED.name()};")
        if self.key_dlg is not None:
            self.key_dlg.refresh()
        if not self.key_ok and not self.key_prompted:
            self.open_key()
        self.key_prompted = True

    def open_key(self):
        if self.key_dlg is None:
            self.key_dlg = KeyDialog(self)
        self.key_dlg.refresh()
        self.key_dlg.show()
        self.key_dlg.raise_()

    def open_apps(self):
        if self.apps_dlg is None:
            self.apps_dlg = AppsDialog(self)
        self.apps_dlg.show()
        self.apps_dlg.raise_()

    def update_list(self):
        if self.updating:
            return
        self.updating = True
        self.btn_update.setEnabled(False)
        self.btn_update.setText("Updating…")
        self.set_msg("Downloading the server list from Mullvad…")

        def done(ok, _out, err):
            self.updating = False
            self.btn_update.setEnabled(True)
            self.btn_update.setText("Update list")
            if ok:
                self.rebuild()
                self.update_top()
                self.set_msg(f"Server list updated: {len(self.by_host)} servers")
            else:
                self.set_msg(f"Update failed: {err}", error=True)

        self.run(["refresh", "force"], done)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("vpn-ns-qt")
    app.setDesktopFileName("vpn-ns-qt")
    w = Main()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
