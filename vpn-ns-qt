def owner_text(r):
    return "Mullvad-owned" if r["owned"] else f"rented · {r['provider']}"


def age_text(path):
    try:
        s = time.time() - path.stat().st_mtime
    except OSError:
        return "list age unknown"
    if s < 60:
        return "list updated just now"
    if s < 3600:
        return f"list updated {int(s // 60)} min ago"
    if s < 86400:
        return f"list updated {int(s // 3600)} h ago"
    return f"list updated {int(s // 86400)} d ago"


