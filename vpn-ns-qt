    def set_msg(self, text, error=False):
        self.msg.setText(text)
        self.msg.setStyleSheet(f"color: {(RED if error else GREEN).name()};")

    def refresh(self):
        m = self.main
        if m.key_ok:
            self.status.setText(f'<span style="color:{GREEN.name()}">Key stored at {m.key_path} (tunnel address {m.key_addr})</span>')
        else:
            self.status.setText(f'<b style="color:{AMBER.name()}">{m.key_problem}</b>')
        if m.key_path and (not self.store.text() or m.key_ok):
            self.store.setText(m.key_path)
        self.btn_delete.setVisible(m.key_ok)

    def browse_import(self):
        p, _ = QFileDialog.getOpenFileName(self, "Select the Mullvad WireGuard .conf", str(Path.home()),
                                           "WireGuard config (*.conf *.cfg *.txt);;All files (*)")
        if p:
            self.path.setText(p)

    def browse_store(self):
        start = self.store.text() or str(Path.home() / "mullvad.conf")
        p, _ = QFileDialog.getSaveFileName(self, "Store the key at", start, "WireGuard config (*.conf);;All files (*)",
                                           options=QFileDialog.Option.DontConfirmOverwrite)
        if p:
            self.store.setText(p)

    def save(self):
        if self.tabs.currentIndex() == 0:
            if not self.path.text().strip():
                self.set_msg("Choose the .conf file first.", error=True)
                return
            args, stdin = ["key", "import", os.path.expanduser(self.path.text().strip())], None
        else:
            if not self.private.text().strip() or not self.address.text().strip():
                self.set_msg("Enter the private key and the tunnel address.", error=True)
                return
            args, stdin = ["key", "set", "--address", self.address.text().strip()], self.private.text().strip() + "\n"
        if self.store.text().strip():
            args += ["--to", os.path.expanduser(self.store.text().strip())]
        self.btn_save.setEnabled(False)
        self.set_msg("Saving…")

        def done(ok, out, err):
            self.btn_save.setEnabled(True)
            if ok:
                self.private.clear()
                self.main.apply_key_status(out)
                self.set_msg("Key saved. A running tunnel uses it at once; otherwise it is used when you connect.")
            else:
                self.set_msg(err, error=True)

        self.main.run(args, done, stdin=stdin)

    def delete(self):
        if QMessageBox.question(self, "Delete stored key", "Delete the stored Mullvad key from this computer?") != QMessageBox.StandardButton.Yes:
            return

        def done(ok, out, err):
            self.main.check_key()
            self.set_msg("Key deleted." if ok else err, error=not ok)

        self.main.run(["key", "remove"], done)


