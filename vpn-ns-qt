    # ---- the list of VPN apps
    def refresh(self):
        def got_list(ok, out, _err):
            items = []
            for line in (out if ok else "").splitlines():
                f = line.split("|", 3)
                if len(f) >= 3:
                    items.append({"name": f[0], "title": f[1], "cmd": f[2]})

            def got_status(ok2, out2, _e):
                running = {l.split("|")[0] for l in (out2 if ok2 else "").splitlines() if l.endswith("|1")}
                self.apply(items, running)

            self.main.run(["apps", "status"], got_status)

        self.main.run(["apps", "list"], got_list)

    def apply(self, items, running):
        self.items, self.running = items, running
        names = [i["name"] for i in items]
        if names != self.names:
            self.rebuild_rows()
        for name, (dot, lab) in self.rows.items():
            on = name in running
            dot.setStyleSheet(f"color: {(GREEN if on else QColor(150, 150, 150)).name()};")
            lab.setVisible(on)
        self.apply_filter()

    def rebuild_rows(self):
        while self.rows_lay.count() > 1:
            w = self.rows_lay.takeAt(0).widget()
            if w:
                w.deleteLater()
        self.rows = {}
        self.names = [i["name"] for i in self.items]
        if not self.items:
            empty = QLabel("No apps yet. Add one below.")
            self.rows_lay.insertWidget(0, empty)
        for pos, it in enumerate(self.items):
            w = QFrame()
            v = QVBoxLayout(w)
            v.setContentsMargins(4, 4, 4, 4)
            top = QHBoxLayout()
            dot = QLabel("●")
            title = QLabel(f"<b>{it['title']}</b>")
            run = QLabel("running in the VPN")
            run.setStyleSheet(f"color: {GREEN.name()};")
            run.setVisible(False)
            launch = QPushButton("Launch")
            remove = QPushButton("Remove")
            top.addWidget(dot)
            top.addWidget(title)
            top.addWidget(run)
            top.addStretch(1)
            top.addWidget(launch)
            top.addWidget(remove)
            cmd = QLabel(it["cmd"])
            cmd.setStyleSheet("color: gray; font-size: 9pt;")
            v.addLayout(top)
            v.addWidget(cmd)
            launch.clicked.connect(lambda _=False, n=it["name"], t=it["title"]: self.launch(n, t))
            remove.clicked.connect(lambda _=False, n=it["name"], b=remove: self.remove(n, b))
            self.rows_lay.insertWidget(pos, w)
            self.rows[it["name"]] = (dot, run)

    def launch(self, name, title):
        QProcess.startDetached(str(SCRIPT), ["app", name])
        self.set_msg(f"Started {title} through the VPN.")

    def remove(self, name, button):
        if button.text() != "Really remove?":
            button.setText("Really remove?")
            QTimer.singleShot(4000, lambda: button.setText("Remove") if button else None)
            return

        def done(ok, _out, err):
            self.set_msg("Removed." if ok else err, error=not ok)
            self.refresh()

        self.main.run(["apps", "remove", name], done)

    # ---- adding
    def scanned(self, ok, out, _err):
        self.installed.clear()
        for line in (out if ok else "").splitlines():
            f = line.split("|", 3)
            if len(f) == 4:
                it = QListWidgetItem(f"{f[1]}      {f[2]}")
                it.setData(Qt.ItemDataRole.UserRole, f)
                self.installed.addItem(it)
        self.apply_filter()

    def apply_filter(self, *_):
        t = self.filter.text().lower().strip()
        firsts = {i["cmd"].split()[0] for i in self.items if i["cmd"].split()}
        for n in range(self.installed.count()):
            it = self.installed.item(n)
            f = it.data(Qt.ItemDataRole.UserRole)
            in_list = f[2].split()[0] in firsts if f[2].split() else False
            it.setHidden(bool(t) and t not in it.text().lower())
            if in_list and not it.text().endswith("(in the list)"):
                it.setText(it.text() + "     (in the list)")
            it.setFlags(it.flags() & ~Qt.ItemFlag.ItemIsEnabled if in_list else it.flags() | Qt.ItemFlag.ItemIsEnabled)

    def add_installed(self):
        it = self.installed.currentItem()
        if not it:
            self.set_msg("Select an app in the list first.", error=True)
            return
        f = it.data(Qt.ItemDataRole.UserRole)
        name = re.sub(r"[^a-z0-9_-]", "-", f[0].lower()).lstrip("-_")
        self.run_add([name, f"{f[1]} (VPN)", f[2], f[3]])

    def add_custom(self):
        self.run_add([self.c_name.text().strip(), self.c_title.text().strip(), self.c_cmd.text().strip(), self.c_icon.text().strip()])

    def run_add(self, fields):
        def done(ok, out, err):
            if ok:
                note = out.split("|", 2)[2] if out.count("|") >= 2 else ""
                self.set_msg(f"Added. {note}")
                for w in (self.c_name, self.c_title, self.c_cmd, self.c_icon):
                    w.clear()
                self.refresh()
            else:
                self.set_msg(err, error=True)

        self.main.run(["apps", "add", *fields], done)


